    "vue3-carousel": "^0.17.0"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.0.0",
    "@types/node": "^22.19.11",
    "autoprefixer": "^10.4.27",
    "oxfmt": "^0.x",
    "oxlint": "^1.x",
    "oxlint-tsgolint": "^0.x",
    "typescript": "^6.0.0",
